<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="me.kristijanbobovec.museum.controller.CityCrudController"
            minWidth="700" minHeight="500">

    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu mnemonicParsing="false" text="Home" onAction="#handleHome"/>
                    <Menu mnemonicParsing="false" text="Edit">
                        <items>
                            <MenuItem mnemonicParsing="false" text="Country"    onAction="#handleCountry"/>
                            <MenuItem mnemonicParsing="false" text="City"       onAction="#handleCity"/>
                            <MenuItem mnemonicParsing="false" text="Collection" onAction="#handleCollection"/>
                            <MenuItem mnemonicParsing="false" text="Museum"     onAction="#handleMuseum"/>
                            <MenuItem mnemonicParsing="false" text="Exhibit"    onAction="#handleExhibit"/>
                            <MenuItem mnemonicParsing="false" text="Curator"    onAction="#handleCurator"/>
                        </items>
                    </Menu>
                    <Menu mnemonicParsing="false" text="Admin" fx:id="adminMenu">
                        <items>
                            <MenuItem mnemonicParsing="false" text="Create Backup" onAction="#handleCreateBackup"/>
                            <MenuItem mnemonicParsing="false" text="Load Backup"   onAction="#handleLoadBackup"/>
                            <MenuItem mnemonicParsing="false" text="Delete All"    onAction="#handleDeleteAll"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                <Label text="City Management"
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.42">

            <!-- LEFT: List -->
            <VBox style="-fx-background-color: #ffffff;">
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                    <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                    <Label text="Search:" style="-fx-font-weight: bold; -fx-text-fill: #444444;"/>
                    <TextField fx:id="searchField" promptText="Filter cities..." HBox.hgrow="ALWAYS"/>
                </HBox>
                <TableView fx:id="tableView" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;">
                    <padding><Insets top="4" right="8" bottom="4" left="8"/></padding>
                    <columns>
                        <TableColumn fx:id="nameColumn" text="City" prefWidth="130"/>
                        <TableColumn fx:id="countryColumn" text="Country" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- RIGHT: Form -->
            <BorderPane style="-fx-background-color: #ffffff;">
                <center>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
                                BorderPane.alignment="TOP_LEFT">
                        <VBox spacing="16">
                            <padding><Insets top="24" right="24" bottom="16" left="24"/></padding>

                            <Label text="City Details"
                                   style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

                            <VBox spacing="6">
                                <Label text="Name *" style="-fx-font-weight: bold; -fx-text-fill: #444444;"/>
                                <TextField fx:id="nameField" promptText="Enter city name" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Country *" style="-fx-font-weight: bold; -fx-text-fill: #444444;"/>
                                <ComboBox fx:id="countryComboBox" promptText="Select country"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <Label fx:id="errorLabel" text="" wrapText="true"
                                   visible="false" managed="false"
                                   style="-fx-text-fill: #c0392b; -fx-font-size: 12;"/>
                        </VBox>
                    </ScrollPane>
                </center>

                <bottom>
                    <HBox spacing="8" alignment="CENTER_LEFT"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                        <padding><Insets top="12" right="16" bottom="12" left="24"/></padding>
                        <Button fx:id="createButton" text="Create" onAction="#handleCreate"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;"/>
                        <Button fx:id="updateButton" text="Update" onAction="#handleUpdate"
                                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;"/>
                        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"
                                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="clearButton" text="Clear" onAction="#handleClear"
                                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;"/>
                    </HBox>
                </bottom>
            </BorderPane>

        </SplitPane>
    </center>

</BorderPane>
