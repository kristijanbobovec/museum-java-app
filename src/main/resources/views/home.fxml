<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="me.kristijanbobovec.museum.controller.HelloWorldController">
    <top>
        <MenuBar>
            <menus>
                <Menu mnemonicParsing="false" text="Home" />
                <Menu mnemonicParsing="false" text="Edit">
                    <items>
                        <MenuItem mnemonicParsing="false" text="New Museum" />
                        <MenuItem mnemonicParsing="false" text="New Collection" />
                        <MenuItem mnemonicParsing="false" text="Edit Exhibit" />
                        <MenuItem mnemonicParsing="false" text="Edit Curator" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Admin">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Create Backup" />
                        <MenuItem mnemonicParsing="false" text="Load Backup" />
                        <MenuItem mnemonicParsing="false" text="Delete All" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <StackPane>
            <Label fx:id="noMuseumsLabel"
                   text="Nema muzeja. Dodajte novi muzej putem Edit → New Museum."
                   visible="false"
                   style="-fx-font-size: 16; -fx-text-fill: #888888;" />
            <ScrollPane fx:id="museumsScrollPane" fitToWidth="true" visible="false">
                <content>
                    <FlowPane fx:id="museumsFlowPane" hgap="16" vgap="16">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16" />
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
