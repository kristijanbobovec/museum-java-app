<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="me.kristijanbobovec.museum.controller.HomeController"
            minWidth="640" minHeight="480">
    <top>
        <VBox>
            <fx:include source="navigation.fxml"/>
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets top="8" right="16" bottom="8" left="16" />
                </padding>
                <Label text="Search:" style="-fx-font-weight: bold; -fx-text-fill: #444444;" />
                <TextField fx:id="searchField" prefWidth="220" promptText="Name of museum..." />
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <Label fx:id="noMuseumsLabel"
                   visible="false"
                   style="-fx-font-size: 15; -fx-text-fill: #888888;" />

            <ListView fx:id="museumsListView"
                      onMouseClicked="#handleMuseumSelected"
                      visible="false"
                      style="-fx-background-color: transparent;">
                <padding>
                    <Insets top="12" right="16" bottom="12" left="16" />
                </padding>
            </ListView>
        </StackPane>
    </center>
</BorderPane>
