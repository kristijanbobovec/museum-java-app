<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="560" minWidth="820" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="me.kristijanbobovec.museum.controller.CuratorController">

    <top>
        <VBox>
            <fx:include source="navigation.fxml" />
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="12" left="16" right="16" top="12" /></padding>
                <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Curator Management" />
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.38">

            <!-- LEFT: List -->
            <VBox style="-fx-background-color: #ffffff;">
                <VBox style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                    <padding><Insets bottom="8" left="12" right="12" top="8" /></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Search:" />
                        <TextField fx:id="searchField" promptText="Filter curators..." HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>
                <TableView fx:id="tableView" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="4" left="8" right="8" top="4" /></padding>
                </TableView>
            </VBox>

            <!-- RIGHT: Form -->
            <BorderPane style="-fx-background-color: #ffffff;">
                <center>
                    <VBox spacing="14">
                        <padding><Insets bottom="0" left="20" right="20" top="20" /></padding>

                        <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Curator Details" />

                        <HBox spacing="12">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="First Name *" />
                                <TextField fx:id="firstNameField" maxWidth="Infinity" promptText="Enter first name" />
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Last Name *" />
                                <TextField fx:id="lastNameField" maxWidth="Infinity" promptText="Enter last name" />
                            </VBox>
                        </HBox>

                        <VBox spacing="6">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Museum *" />
                            <ComboBox fx:id="museumComboBox" maxWidth="Infinity" promptText="Select museum" />
                        </VBox>

                        <Label fx:id="errorLabel" managed="false" style="-fx-text-fill: #c0392b; -fx-font-size: 12;" text="" visible="false" wrapText="true" />

                        <!-- Collections drag-and-drop -->
                        <VBox spacing="6" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Collections" />
                                <Label style="-fx-text-fill: #888888; -fx-font-size: 11;" text="— drag between lists to assign" />
                            </HBox>
                            <HBox spacing="8" VBox.vgrow="ALWAYS">

                                <!-- Available collections -->
                                <VBox spacing="0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-background-color: #f0f4f8; -fx-text-fill: #555555; -fx-font-weight: bold; -fx-padding: 5 8 5 8; -fx-border-color: #c8d8e8; -fx-border-width: 1 1 0 1;" text="Available" />
                                    <ListView fx:id="availableCollectionsListView" style="-fx-background-color: transparent; -fx-border-color: #c8d8e8; -fx-border-width: 0 1 1 1;" VBox.vgrow="ALWAYS" />
                                </VBox>

                                <!-- Arrow hint -->
                                <VBox alignment="CENTER" prefWidth="28">
                                    <Label style="-fx-font-size: 18; -fx-text-fill: #aaaaaa;" text="⇄" />
                                </VBox>

                                <!-- Assigned collections -->
                                <VBox spacing="0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-background-color: #f0f8f4; -fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-padding: 5 8 5 8; -fx-border-color: #a8dfc0; -fx-border-width: 1 1 0 1;" text="Assigned" />
                                    <ListView fx:id="assignedCollectionsListView" style="-fx-background-color: transparent; -fx-border-color: #a8dfc0; -fx-border-width: 0 1 1 1;" VBox.vgrow="ALWAYS" />
                                </VBox>

                            </HBox>
                        </VBox>

                    </VBox>
                </center>

                <bottom>
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                        <padding><Insets bottom="12" left="20" right="16" top="12" /></padding>
                        <Button fx:id="createButton" onAction="#handleCreate" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;" text="Create" />
                        <Button fx:id="updateButton" onAction="#handleUpdate" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;" text="Update" />
                        <Button fx:id="deleteButton" onAction="#handleDelete" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;" text="Delete" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="clearButton" onAction="#handleClear" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;" text="Clear" />
                    </HBox>
                </bottom>
            </BorderPane>

        </SplitPane>
    </center>

</BorderPane>
