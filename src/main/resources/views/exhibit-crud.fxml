<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="580" minWidth="800" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="me.kristijanbobovec.museum.controller.ExhibitController">

    <top>
        <VBox>
            <fx:include source="navigation.fxml" />
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="12" left="16" right="16" top="12" /></padding>
                <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Exhibit Management" />
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.38">

            <!-- LEFT: List -->
            <VBox style="-fx-background-color: #ffffff;">
                <VBox style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                    <padding><Insets bottom="8" left="12" right="12" top="8" /></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Search:" />
                        <TextField fx:id="searchField" promptText="Filter exhibits..." HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <VBox.margin><Insets top="6" /></VBox.margin>
                    </HBox>
                </VBox>
                <TableView fx:id="tableView" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="4" left="8" right="8" top="4" /></padding>
                </TableView>
            </VBox>

            <!-- RIGHT: Form -->
            <BorderPane style="-fx-background-color: #ffffff;">
                <center>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" BorderPane.alignment="TOP_LEFT">
                        <VBox spacing="14">
                            <padding><Insets bottom="16" left="24" right="24" top="24" /></padding>

                            <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Exhibit Details" />

                            <VBox spacing="6">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Name *" />
                                <TextField fx:id="nameField" maxWidth="Infinity" promptText="Enter exhibit name" />
                            </VBox>

                            <VBox spacing="6">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Creation Year" />
                                <TextField fx:id="yearField" maxWidth="Infinity" promptText="e.g. 1503" />
                            </VBox>

                            <VBox spacing="6">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Museum *" />
                                <ComboBox fx:id="museumComboBox" maxWidth="Infinity" promptText="Select museum" />
                            </VBox>

                            <VBox spacing="6">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Collection (optional)" />
                                <ComboBox fx:id="collectionComboBox" maxWidth="Infinity" promptText="Select collection" />
                            </VBox>

                            <VBox spacing="6">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Description" />
                                <TextArea fx:id="descriptionField" maxWidth="Infinity" prefRowCount="4" promptText="Enter exhibit description" wrapText="true" />
                            </VBox>

                            <VBox spacing="6">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #444444;" text="Image Path" />
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <TextField fx:id="imagePathField" promptText="Path to image file" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="browseButton" onAction="#handleBrowse" style="-fx-cursor: hand; -fx-padding: 6 12 6 12;" text="Browse..." />
                                </HBox>
                            </VBox>

                            <Label fx:id="errorLabel" managed="false" style="-fx-text-fill: #c0392b; -fx-font-size: 12;" text="" visible="false" wrapText="true" />
                        </VBox>
                    </ScrollPane>
                </center>

                <bottom>
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                        <padding><Insets bottom="12" left="24" right="16" top="12" /></padding>
                        <Button fx:id="createButton" onAction="#handleCreate" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;" text="Create" />
                        <Button fx:id="updateButton" onAction="#handleUpdate" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;" text="Update" />
                        <Button fx:id="deleteButton" onAction="#handleDelete" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;" text="Delete" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="clearButton" onAction="#handleClear" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;" text="Clear" />
                    </HBox>
                </bottom>
            </BorderPane>

        </SplitPane>
    </center>

</BorderPane>
